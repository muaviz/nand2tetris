class Dajjal {
    field int x, y;
    field int width, height;

    constructor Dajjal new(int Ax, int Ay) {
        let x = Ax;
        let y = Ay;
        let width = 20;
        let height = 20;

        do draw();

        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
    method void draw() {
        do Screen.setColor(true);
        do Screen.drawRectangle(x, y, x + width, y + height);
        do Screen.setColor(false);
        do Screen.drawCircle(x + (width / 2), y + (height / 2), 4);
        do Screen.setColor(true);
        do Screen.drawCircle(x + (width / 2), y + (height / 2), 1);
        do Screen.drawLine(x, y, x - 4, y - 6);
        do Screen.drawLine(x + 1, y, x - 3, y - 6);
        do Screen.drawLine(x + width, y, x + width + 4, y - 6);
        do Screen.drawLine(x + width - 1, y, x + width + 3, y - 6);

        return;
    }

    method void hide() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + width, y + height);
        do Screen.drawLine(x, y, x - 4, y - 6);
        do Screen.drawLine(x + 1, y, x - 3, y - 6);
        do Screen.drawLine(x + width, y, x + width + 4, y - 6);
        do Screen.drawLine(x + width - 1, y, x + width + 3, y - 6);

        return;
    }

    method void spawn(int newX, int newY) {
        do hide();
        let x = newX;
        let y = newY;
        do draw();

        return;
    }

    method boolean checkHit(int cx, int cy) {
        var boolean hitX, hitY;
        let hitX = (~(cx < x)) & (~(cx > (x + width)));
        let hitY = (~(cy < y)) & (~(cy > (y + height)));

        return hitX & hitY;
    }
}
