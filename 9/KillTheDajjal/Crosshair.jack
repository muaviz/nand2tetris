class Crosshair {
    field int x, y;
    field int size;
    field int step;

    constructor Crosshair new(int Ax, int Ay) {
        let x = Ax;
        let y = Ay;
        let size = 5;
        let step = 5;

        do draw();

        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do Screen.drawLine(x - size, y, x + size, y);
        do Screen.drawLine(x, y - size, x, y + size);
        return;
    }

    method void hide() {
        do Screen.setColor(false);
        do Screen.drawLine(x - size, y, x + size, y);
        do Screen.drawLine(x, y - size, x, y + size);
        return;
    }

    method void moveLeft() {
        do hide();
        if (x - step > 10) {
            let x = x - step;
        }
        do draw();
        return;
    }
    method void moveRight() {
        do hide();
        if ((x + step + size) < 511) {
            let x = x + step;
        }
        do draw();
        return;
    }
    method void moveUp() {
        do hide();
        if (y - step > 35) {
            let y = y - step;
        }
        do draw();
        return;
    }
    method void moveDown() {
        do hide();
        if (y + step < 250) {
            let y = y + step;
        }
        do draw();
        return;
    }

    method int getX() { return x; }
    method int getY() { return y; }
}
